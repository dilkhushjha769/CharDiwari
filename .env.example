# Supabase Authentication & Database Configuration
# Obtain these from your Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Google Maps Platform (property page: 3D view, Street View, map, commute check)
# Leave empty to show the "Map preview unavailable" card instead. See README.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# PostHog Product Analytics & Session Replay
# Obtain from PostHog Console -> Project Settings -> Project API Key
NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_project_api_key_here
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com # Use https://eu.i.posthog.com for EU cloud or https://us.i.posthog.com for US cloud
NEXT_PUBLIC_POSTHOG_APP_URL=https://eu.posthog.com # Web app domain (eu.posthog.com or us.posthog.com)
NEXT_PUBLIC_POSTHOG_PROJECT_ID=303531 # Your numeric project ID
# Optional: Personal API Key (phx_...) for server-side dashboard HogQL queries (never exposed to browser)
POSTHOG_PERSONAL_API_KEY=


